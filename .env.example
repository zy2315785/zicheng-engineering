# 复制为 .env 后填写；.env 已被 .gitignore 排除，不会进仓库。
# 也可以直接写在 .local/api-config.json、.local/cloud-config.json，但同样不要提交。

# ---------- 模型（DeepSeek 或任意 OpenAI 兼容接口） ----------
ZC_API_KEY=
ZC_API_BASE=https://api.deepseek.com
ZC_API_MODEL=deepseek-chat

# ---------- ima 知识库 ----------
IMA_OPENAPI_CLIENTID=
IMA_OPENAPI_APIKEY=

# ---------- EdgeOne 云函数 ----------
DEEPSEEK_API_KEY=
DEEPSEEK_BASE=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_MAX_TOKENS=8192
IMA_CLIENT_ID=
IMA_API_KEY=
IMA_KB_NAME=子城
# 部署内 Blob 由平台自动认证。本机调试令牌仅放私有环境文件。
# BLOB_TOKEN=
# BLOB_PROJECT_ID=makers-cnwks8jmg4xl
