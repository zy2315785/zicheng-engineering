# 复制为 .env 后填写；.env 已被 .gitignore 排除，不会进仓库。
# 也可以直接写在 .local/api-config.json、.local/cloud-config.json，但同样不要提交。

# ---------- 模型（DeepSeek 或任意 OpenAI 兼容接口） ----------
ZC_API_KEY=
ZC_API_BASE=https://api.deepseek.com
ZC_API_MODEL=deepseek-chat

# ---------- ima 知识库 ----------
IMA_OPENAPI_CLIENTID=
IMA_OPENAPI_APIKEY=
